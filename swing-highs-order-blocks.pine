//@version=6
indicator("ICT Sessions + IFVG + Order Blocks + OTE", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================
// MODULE 1: TRADING SESSIONS
// ============================================

group_sessions = "SESSION SETTINGS"

asiaEnabled = input.bool(true, "Asia ON/OFF", group=group_sessions)
asiaStart = input.string("00:00", "Asia Start Time", group=group_sessions)
asiaEnd = input.string("09:00", "Asia End Time", group=group_sessions)
asiaColor = input.color(color.new(color.blue, 80), "Asia Color", group=group_sessions)

londonEnabled = input.bool(true, "London ON/OFF", group=group_sessions)
londonStart = input.string("08:00", "London Start Time", group=group_sessions)
londonEnd = input.string("17:00", "London End Time", group=group_sessions)
londonColor = input.color(color.new(color.orange, 80), "London Color", group=group_sessions)

nyEnabled = input.bool(true, "New York ON/OFF", group=group_sessions)
nyStart = input.string("13:00", "NY Start Time", group=group_sessions)
nyEnd = input.string("22:00", "NY End Time", group=group_sessions)
nyColor = input.color(color.new(color.red, 80), "NY Color", group=group_sessions)

sessionTimeZone = input.string("UTC", "Timezone", options=["UTC", "GMT+1", "GMT+2", "EST", "CST", "PST"], group=group_sessions)

var float asiaSessionHigh = na
var float asiaSessionLow = na
var float londonSessionHigh = na
var float londonSessionLow = na
var float nySessionHigh = na
var float nySessionLow = na

var string lastAsiaSession = ""
var string lastLondonSession = ""
var string lastNySession = ""

f_parseTimeString(timeStr) =>
    parts = str.split(timeStr, ":")
    hourStr = array.get(parts, 0)
    minStr = array.get(parts, 1)
    hour = str.tonumber(hourStr)
    minute = str.tonumber(minStr)
    hour := na(hour) ? 0 : hour
    minute := na(minute) ? 0 : minute
    [hour, minute]

f_timeInRange(sessionStart, sessionEnd) =>
    [startHour, startMin] = f_parseTimeString(sessionStart)
    [endHour, endMin] = f_parseTimeString(sessionEnd)
    
    currentTime = time(timeframe.period, sessionTimeZone)
    currentHour = hour(currentTime)
    currentMin = minute(currentTime)
    
    startMinutes = startHour * 60 + startMin
    endMinutes = endHour * 60 + endMin
    currentMinutes = currentHour * 60 + currentMin
    
    if startMinutes <= endMinutes
        currentMinutes >= startMinutes and currentMinutes < endMinutes
    else
        currentMinutes >= startMinutes or currentMinutes < endMinutes

f_drawSessionLine(sessionHigh, sessionLow, sessionColor, sessionName) =>
    if not na(sessionHigh) and not na(sessionLow)
        line.new(bar_index - 1, sessionHigh, bar_index, sessionHigh, color=sessionColor, width=2)
        line.new(bar_index - 1, sessionLow, bar_index, sessionLow, color=sessionColor, width=2)
        
        label.new(bar_index, sessionHigh, sessionName + " H", color=sessionColor, textcolor=color.white, size=size.small, style=label.style_label_center)
        label.new(bar_index, sessionLow, sessionName + " L", color=sessionColor, textcolor=color.white, size=size.small, style=label.style_label_center)

if asiaEnabled
    isAsiaSession = f_timeInRange(asiaStart, asiaEnd)
    currentAsiaSession = str.format("{0}-{1}", year, dayofweek)
    
    if isAsiaSession
        if currentAsiaSession != lastAsiaSession
            asiaSessionHigh := high
            asiaSessionLow := low
            lastAsiaSession := currentAsiaSession
        else
            asiaSessionHigh := math.max(asiaSessionHigh, high)
            asiaSessionLow := math.min(asiaSessionLow, low)
    
    if not na(asiaSessionHigh) and not na(asiaSessionLow)
        f_drawSessionLine(asiaSessionHigh, asiaSessionLow, asiaColor, "Asia")

if londonEnabled
    isLondonSession = f_timeInRange(londonStart, londonEnd)
    currentLondonSession = str.format("{0}-{1}", year, dayofweek)
    
    if isLondonSession
        if currentLondonSession != lastLondonSession
            londonSessionHigh := high
            londonSessionLow := low
            lastLondonSession := currentLondonSession
        else
            londonSessionHigh := math.max(londonSessionHigh, high)
            londonSessionLow := math.min(londonSessionLow, low)
    
    if not na(londonSessionHigh) and not na(londonSessionLow)
        f_drawSessionLine(londonSessionHigh, londonSessionLow, londonColor, "London")

if nyEnabled
    isNySession = f_timeInRange(nyStart, nyEnd)
    currentNySession = str.format("{0}-{1}", year, dayofweek)
    
    if isNySession
        if currentNySession != lastNySession
            nySessionHigh := high
            nySessionLow := low
            lastNySession := currentNySession
        else
            nySessionHigh := math.max(nySessionHigh, high)
            nySessionLow := math.min(nySessionLow, low)
    
    if not na(nySessionHigh) and not na(nySessionLow)
        f_drawSessionLine(nySessionHigh, nySessionLow, nyColor, "NY")

// ============================================
// MODULE 2: MARKET STRUCTURE
// ============================================

group_structure = "MARKET STRUCTURE"

swingLength = input.int(5, "Swing Length", minval=1, group=group_structure)
showStructure = input.bool(true, "Show Structure", group=group_structure)
showBOSLabels = input.bool(true, "Show BOS Labels", group=group_structure)

var array<int> swingHighBars = array.new<int>()
var array<float> swingHighPrices = array.new<float>()
var array<int> swingLowBars = array.new<int>()
var array<float> swingLowPrices = array.new<float>()

f_isSwingHigh(index) =>
    high[index] == ta.highest(high, swingLength * 2 + 1)

f_isSwingLow(index) =>
    low[index] == ta.lowest(low, swingLength * 2 + 1)

if showStructure
    if f_isSwingHigh(swingLength)
        array.push(swingHighBars, bar_index[swingLength])
        array.push(swingHighPrices, high[swingLength])
        if array.size(swingHighBars) > 100
            array.shift(swingHighBars)
            array.shift(swingHighPrices)
    
    if f_isSwingLow(swingLength)
        array.push(swingLowBars, bar_index[swingLength])
        array.push(swingLowPrices, low[swingLength])
        if array.size(swingLowBars) > 100
            array.shift(swingLowBars)
            array.shift(swingLowPrices)

// ============================================
// MODULE 3: FAIR VALUE GAPS & IFVG
// ============================================

group_fvg = "FVG / IFVG SETTINGS"

showFVG = input.bool(true, "FVG ON/OFF", group=group_fvg)
showIFVG = input.bool(true, "IFVG ON/OFF", group=group_fvg)
minGapSize = input.float(0.0, "Minimum Gap Size (pips)", minval=0.0, group=group_fvg)
useATRFilter = input.bool(false, "Use ATR Filter", group=group_fvg)
atrPeriod = input.int(14, "ATR Period", minval=1, group=group_fvg)
atrMultiplier = input.float(1.0, "ATR Multiplier", minval=0.1, group=group_fvg)
bullishFVGColor = input.color(color.new(color.green, 80), "Bullish FVG Color", group=group_fvg)
bearishFVGColor = input.color(color.new(color.red, 80), "Bearish FVG Color", group=group_fvg)
bullishIFVGColor = input.color(color.new(color.blue, 80), "Bullish IFVG Color", group=group_fvg)
bearishIFVGColor = input.color(color.new(color.orange, 80), "Bearish IFVG Color", group=group_fvg)
maxFVGZones = input.int(20, "Max FVG/IFVG Zones", minval=1, group=group_fvg)

var array<box> fvgBoxes = array.new<box>()
var array<bool> isIFVG = array.new<bool>()
var array<bool> fvgActive = array.new<bool>()

f_isBullishFVG() =>
    low[2] > high[1]

f_isBearishFVG() =>
    high[2] < low[1]

f_getGapSize() =>
    atrVal = ta.atr(atrPeriod)
    if useATRFilter
        atrVal * atrMultiplier
    else
        minGapSize

if showFVG
    currentGapSize = f_getGapSize()
    
    if f_isBullishFVG()
        gapSize = low[2] - high[1]
        if gapSize >= currentGapSize
            gapBox = box.new(bar_index[2], high[1], bar_index[1], low[2], border_color=bullishFVGColor, bgcolor=bullishFVGColor)
            array.push(fvgBoxes, gapBox)
            array.push(isIFVG, false)
            array.push(fvgActive, true)
            if array.size(fvgBoxes) > maxFVGZones
                array.shift(fvgBoxes)
                array.shift(isIFVG)
                array.shift(fvgActive)
    
    if f_isBearishFVG()
        gapSize = low[1] - high[2]
        if gapSize >= currentGapSize
            gapBox = box.new(bar_index[2], high[2], bar_index[1], low[1], border_color=bearishFVGColor, bgcolor=bearishFVGColor)
            array.push(fvgBoxes, gapBox)
            array.push(isIFVG, false)
            array.push(fvgActive, true)
            if array.size(fvgBoxes) > maxFVGZones
                array.shift(fvgBoxes)
                array.shift(isIFVG)
                array.shift(fvgActive)

if showIFVG and array.size(fvgBoxes) > 0
    for i = 0 to array.size(fvgBoxes) - 1
        if i < array.size(fvgActive)
            fvgBox = array.get(fvgBoxes, i)
            isFVG = not array.get(isIFVG, i)
            isActive = array.get(fvgActive, i)
            
            if isActive and isFVG
                boxTop = box.get_top(fvgBox)
                boxBot = box.get_bottom(fvgBox)
                
                if boxTop > boxBot
                    if close < boxBot
                        array.set(isIFVG, i, true)
                        box.set_bgcolor(fvgBox, bullishIFVGColor)
                        box.set_border_color(fvgBox, bullishIFVGColor)
                else
                    if close > boxTop
                        array.set(isIFVG, i, true)
                        box.set_bgcolor(fvgBox, bearishIFVGColor)
                        box.set_border_color(fvgBox, bearishIFVGColor)

// ============================================
// MODULE 4: ORDER BLOCKS
// ============================================

group_ob = "ORDER BLOCK SETTINGS"

showOB = input.bool(true, "OB ON/OFF", group=group_ob)
obDisplacement = input.float(1.0, "Displacement Sensitivity (ATR)", minval=0.1, group=group_ob)
obMitigation = input.string("close", "Mitigation Method", options=["close", "wick"], group=group_ob)
bullishOBColor = input.color(color.new(color.green, 85), "Bullish OB Color", group=group_ob)
bearishOBColor = input.color(color.new(color.red, 85), "Bearish OB Color", group=group_ob)
maxOBCount = input.int(15, "Max Order Blocks", minval=1, group=group_ob)

var array<box> obBoxes = array.new<box>()
var array<bool> obMitigated = array.new<bool>()
var array<string> obType = array.new<string>()

f_isBullishOB(idx) =>
    close[idx] > open[idx] and close[idx - 1] < open[idx - 1]

f_isBearishOB(idx) =>
    close[idx] < open[idx] and close[idx - 1] > open[idx - 1]

if showOB
    atrVal = ta.atr(atrPeriod)
    displacement = atrVal * obDisplacement
    
    if f_isBullishOB(1)
        obBox = box.new(bar_index[1], high[1], bar_index, low[1], border_color=bullishOBColor, bgcolor=bullishOBColor)
        array.push(obBoxes, obBox)
        array.push(obMitigated, false)
        array.push(obType, "bullish")
        if array.size(obBoxes) > maxOBCount
            array.shift(obBoxes)
            array.shift(obMitigated)
            array.shift(obType)
    
    if f_isBearishOB(1)
        obBox = box.new(bar_index[1], high[1], bar_index, low[1], border_color=bearishOBColor, bgcolor=bearishOBColor)
        array.push(obBoxes, obBox)
        array.push(obMitigated, false)
        array.push(obType, "bearish")
        if array.size(obBoxes) > maxOBCount
            array.shift(obBoxes)
            array.shift(obMitigated)
            array.shift(obType)

if showOB and array.size(obBoxes) > 0
    for i = 0 to array.size(obBoxes) - 1
        if i < array.size(obMitigated)
            obBox = array.get(obBoxes, i)
            isMit = array.get(obMitigated, i)
            obT = array.get(obType, i)
            
            if not isMit
                boxTop = box.get_top(obBox)
                boxBot = box.get_bottom(obBox)
                
                if obT == "bullish"
                    if obMitigation == "close"
                        if close > boxTop
                            array.set(obMitigated, i, true)
                            box.set_border_color(obBox, color.gray)
                            box.set_bgcolor(obBox, color.new(color.gray, 85))
                    else
                        if high > boxTop
                            array.set(obMitigated, i, true)
                            box.set_border_color(obBox, color.gray)
                            box.set_bgcolor(obBox, color.new(color.gray, 85))
                else
                    if obMitigation == "close"
                        if close < boxBot
                            array.set(obMitigated, i, true)
                            box.set_border_color(obBox, color.gray)
                            box.set_bgcolor(obBox, color.new(color.gray, 85))
                    else
                        if low < boxBot
                            array.set(obMitigated, i, true)
                            box.set_border_color(obBox, color.gray)
                            box.set_bgcolor(obBox, color.new(color.gray, 85))
                
                box.set_right(obBox, bar_index)

// ============================================
// ALERTS
// ============================================

group_alerts = "ALERTS"

alertFVG = input.bool(true, "Alert on FVG", group=group_alerts)
alertIFVG = input.bool(true, "Alert on IFVG", group=group_alerts)
alertOB = input.bool(true, "Alert on OB", group=group_alerts)

if alertFVG and array.size(fvgBoxes) > 0
    if array.size(isIFVG) > 0
        lastFVG = not array.get(isIFVG, array.size(isIFVG) - 1)
        if lastFVG
            alert("New FVG Detected!", alert.freq_once_per_bar)

if alertIFVG and array.size(fvgBoxes) > 0
    if array.size(isIFVG) > 0
        lastIFVG = array.get(isIFVG, array.size(isIFVG) - 1)
        if lastIFVG
            alert("IFVG Converted!", alert.freq_once_per_bar)

if alertOB and array.size(obBoxes) > 0
    if array.size(obMitigated) > 0
        lastOB = not array.get(obMitigated, array.size(obMitigated) - 1)
        if lastOB
            alert("New Order Block!", alert.freq_once_per_bar)
