//@version=5
indicator("Swing Highs + Order Blocks + IFVG + OTE", overlay=true)

// ============================================
// INPUT SETTINGS
// ============================================

// Swing Settings
swingLength = input.int(5, "Swing Length", minval=1)
swingHighColor = input.color(color.red, "Swing High Color")

// Order Block Settings
showOrderBlocks = input.bool(true, "Show Order Blocks")
obColor = input.color(color.blue, "Order Block Color")

// IFVG Settings
showIFVG = input.bool(true, "Show IFVG")
ifvgColor = input.color(color.orange, "IFVG Color")

// OTE Settings
showOTE = input.bool(true, "Show OTE")
oteColor = input.color(color.green, "OTE Color")

// ============================================
// SWING HIGH DETECTION
// ============================================

isSwingHigh = high[swingLength] == ta.highest(high, swingLength * 2 + 1)

if isSwingHigh
    plotshape(isSwingHigh, location=location.abovebar, shape=shape.diamond, color=swingHighColor, size=size.small)

// ============================================
// ORDER BLOCK DETECTION
// ============================================

if showOrderBlocks
    bullishOB = close[1] > open[1] and close < low[1]
    bearishOB = close[1] < open[1] and close > high[1]
    
    if bullishOB
        box.new(bar_index[1], high[1], bar_index, low[1], border_color=obColor, bgcolor=color.new(obColor, 80))
    
    if bearishOB
        box.new(bar_index[1], high[1], bar_index, low[1], border_color=obColor, bgcolor=color.new(obColor, 80))

// ============================================
// IFVG DETECTION
// ============================================

if showIFVG
    bullishGap = low[2] > high[1]
    bearishGap = high[2] < low[1]
    
    if bullishGap
        box.new(bar_index[2], low[2], bar_index[1], high[1], border_color=ifvgColor, bgcolor=color.new(ifvgColor, 80))
    
    if bearishGap
        box.new(bar_index[2], high[2], bar_index[1], low[1], border_color=ifvgColor, bgcolor=color.new(ifvgColor, 80))

// ============================================
// OTE DETECTION
// ============================================

if showOTE
    swingLow = ta.lowest(low, 5)
    swingHigh = ta.highest(high, 5)
    
    bullishOTE = low <= swingLow * 1.002 and close > open
    bearishOTE = high >= swingHigh * 0.998 and close < open
    
    if bullishOTE
        plotshape(bullishOTE, location=location.belowbar, shape=shape.triangle, color=oteColor, size=size.small)
    
    if bearishOTE
        plotshape(bearishOTE, location=location.abovebar, shape=shape.triangle, color=oteColor, size=size.small)
