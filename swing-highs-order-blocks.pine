//@version=5
indicator("Simple Trading Indicator", overlay=true)

// Simple Swing High
length = input.int(5, "Length")
color1 = input.color(color.red, "Color")

highestHigh = ta.highest(high, length)
isHigh = high == highestHigh

plotshape(isHigh, style=shape.diamond, location=location.abovebar, color=color1)
